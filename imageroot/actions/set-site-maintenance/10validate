import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
import erpnext_sites as es  # noqa: E402



def fail(field, error, value):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all
name = json.load(sys.stdin)["name"]
if name != es.DEFAULT_SITE and name not in es.load_sites():
    fail("name", "site_not_found", name)
if not es.is_running("backend") or name not in es.list_sites():
    fail("name", "site_not_running", name)
