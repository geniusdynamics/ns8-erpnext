import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
import erpnext_sites as es  # noqa: E402

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all

name = json.load(sys.stdin)["name"]
error = None
if name == es.DEFAULT_SITE:
    error = "use_configure_module_for_default_site"
elif name not in es.load_sites():
    error = "site_not_found"
if error:
    agent.set_status("validation-failed")
    json.dump([{"field": "name", "parameter": "name", "value": name, "error": error}], fp=sys.stdout)
    sys.exit(3)
