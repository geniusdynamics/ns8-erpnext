#!/bin/bash

# stdout is reserved for the action output: log to the journal (stderr)
exec 1>&2

set -e
source erpnext-modules.env
# No-cache flag for podman build
NO_CACHE=""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
  echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
  echo -e "${RED}[ERROR]${NC} $1"
}

# Check if podman is installed
if ! command -v podman &>/dev/null; then
  print_error "podman is required but not installed. Please install podman first."
  exit 1
fi

# Check if jq is installed
if ! command -v jq &>/dev/null; then
  print_error "jq is required but not installed. Please install jq first."
  exit 1
fi

# Function to fetch latest ERPNext tag from GitHub based on FRAPPE_VERSION
# Latest frappe/erpnext image tag of the selected major version, from Docker
# Hub, where the base image is pulled from. Messages go to stderr: stdout is
# the tag. Without an answer, use the pinned release below.
# renovate: datasource=docker packageName=docker.io/frappe/erpnext
FALLBACK_TAG_V15=v15.125.0
FALLBACK_TAG_V16=v16.55.0
fetch_erpnext_tag() {
  local major_version="${FRAPPE_VERSION##version-}"
  local api_url="https://hub.docker.com/v2/repositories/frappe/erpnext/tags?page_size=100&name=v${major_version}."
  local tags_json tag
  if ! tags_json=$(curl -fsSL --max-time 30 "$api_url" 2>/dev/null); then
    print_warning "Cannot read the frappe/erpnext tags from Docker Hub" >&2
    return 1
  fi
  tag=$(echo "$tags_json" | jq -r '.results[].name' 2>/dev/null |
    grep -E "^v${major_version}\.[0-9]+\.[0-9]+$" | sort -V | tail -1)
  if [ -z "$tag" ]; then
    print_warning "No v${major_version} release of frappe/erpnext found on Docker Hub" >&2
    return 1
  fi
  echo "$tag"
}

# Cache file for app_json hash
CACHE_FILE=".app_json_cache"
# bench reads url, branch and app_name: drop the catalogue metadata (title),
# so a new title does not rebuild the image
BUILD_APPS_JSON=$(echo "$APPS_JSON" | base64 -d |
  jq -c 'map({url, branch} + (if .app_name then {app_name} else {} end))' | base64 -w0)
CURRENT_APPS_JSON="$BUILD_APPS_JSON"
# Repositories cloned with the stored GitHub token
PRIVATE_REPOS=$(echo "$APPS_JSON" | base64 -d | jq -r '.[] | select(.private == true) | .url' | tr '\n' ' ')

# Function to compute hash of the apps JSON
compute_apps_hash() {
  echo -n "$1" | sha256sum | cut -d' ' -f1
}
# Fetch latest ERPNext tag from GitHub based on FRAPPE_VERSION
# Pinned build (state/image-pins.json, written after each build): the same
# base images by digest, the same image tag and the same app commits. A
# restore, a clone or a change of the app list reproduces the code of the
# last build. A forced rebuild (forceRebuild) takes the newest releases and
# writes new pins. A pin file of another Frappe version does not apply.
PINS_FILE="image-pins.json"
FORCE_REBUILD="${FORCE_REBUILD:-false}"
USE_PINS=""
if [ "$FORCE_REBUILD" != "true" ] && [ -f "$PINS_FILE" ] &&
  [ "$(jq -r '.frappe_branch // empty' "$PINS_FILE" 2>/dev/null)" = "$FRAPPE_VERSION" ]; then
  USE_PINS=1
  print_info "Building from the pins of the last build ($PINS_FILE)"
fi
pin() { [ -n "$USE_PINS" ] && jq -r "$1 // empty" "$PINS_FILE" 2>/dev/null; }

FRAPPE_BUILD_REF=$(pin .build_image) || true
FRAPPE_BASE_REF=$(pin .base_image) || true
FRAPPE_BUILD_REF="${FRAPPE_BUILD_REF:-docker.io/frappe/build:${FRAPPE_VERSION}}"
FRAPPE_BASE_REF="${FRAPPE_BASE_REF:-docker.io/frappe/base:${FRAPPE_VERSION}}"
APP_PINS=$(pin '.apps | to_entries | map("\(.key)=\(.value)") | join(" ")') || true

ERPNEXT_TAG=$(pin .erpnext_tag) || true
if [ -z "${ERPNEXT_TAG:-}" ]; then
  ERPNEXT_TAG=$(fetch_erpnext_tag) || true
fi

if [ -z "${ERPNEXT_TAG:-}" ]; then
  fallback="FALLBACK_TAG_V${FRAPPE_VERSION##version-}"
  ERPNEXT_TAG="${!fallback:-$FALLBACK_TAG_V15}"
  print_warning "Using the pinned ERPNext release ${ERPNEXT_TAG}"
fi
BUILD_FINGERPRINT=$(printf "%s\n%s" \
  "$CURRENT_APPS_JSON" \
  "$ERPNEXT_TAG")
# The pins are not part of the fingerprint: they only change with a build
# Get current apps JSON hash
CURRENT_HASH=$(compute_apps_hash "$BUILD_FINGERPRINT")

# Save old image reference before any changes
OLD_ERPNEXT_IMAGE=""
if [ -f "environment" ]; then
  OLD_ERPNEXT_IMAGE=$(grep '^ERPNEXT_IMAGE=' environment | cut -d'=' -f2 || echo "")
fi

# If force rebuild is requested, skip the cache check
if [ "$FORCE_REBUILD" = "true" ]; then
  print_info "Force rebuild requested. Removing cache and proceeding..."
  NO_CACHE="--no-cache"
  rm -f "$CACHE_FILE"
elif [ -f "$CACHE_FILE" ]; then
  CACHED_HASH=$(jq -r '.hash' "$CACHE_FILE" 2>/dev/null || echo "")
  if [ "$CURRENT_HASH" = "$CACHED_HASH" ]; then
    print_warning "App configuration unchanged. Skipping Docker image build."
    print_info "To force a rebuild, delete the cache file: rm $CACHE_FILE"
    exit 0
  else
    rm $CACHE_FILE
    print_info "App configuration changed. Proceeding with Docker image build..."
  fi
else
  print_info "No cache found. Building Docker image from scratch..."
  NO_CACHE="--no-cache"
fi

print_info "Using ERPNext tag: $ERPNEXT_TAG"

ERPNEXT_IMAGE="frappe/erpnext:${ERPNEXT_TAG}"

print_info "ERPNEXT_IMAGE forcibly set to: $ERPNEXT_IMAGE"
# Extract image name and tag from ERPNEXT_IMAGE
BASE_IMAGE="$ERPNEXT_IMAGE"
# Extract repository and tag
IMAGE_REPO=$(echo "$ERPNEXT_IMAGE" | cut -d':' -f1)
IMAGE_TAG=$(echo "$ERPNEXT_IMAGE" | cut -d':' -f2)

# Use the same tag for custom image
CUSTOM_IMAGE_NAME="${IMAGE_REPO}"
CUSTOM_IMAGE_TAG="$IMAGE_TAG"

print_info "Base Image: $BASE_IMAGE"
print_info "Custom Image will be: $CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG"

print_info "Apps to be installed:"
echo "$APPS_JSON"

FRAPPE_BRANCH="${FRAPPE_VERSION}"

print_info "Using Frappe branch: $FRAPPE_BRANCH"
print_info "Building custom ERPNext image with Podman..."

# A GitHub token for the private app repositories (configure-module gitToken,
# apps marked "private") reaches the build as a secret: it is in no image
# layer, and public repositories are cloned without it. Without a token the
# secret is "-".
GIT_TOKEN_SECRET=$(mktemp -p . .git-token-build.XXXXXX)
trap 'rm -f "$GIT_TOKEN_SECRET"' EXIT
if [ -s git-token ] && [ -n "${PRIVATE_REPOS// /}" ]; then
  cat git-token >"$GIT_TOKEN_SECRET"
  print_info "Using the stored GitHub token for: $PRIVATE_REPOS"
else
  echo "-" >"$GIT_TOKEN_SECRET"
fi

# Build the image with Podman
podman build --network=host \
  $NO_CACHE \
  --jobs=4 \
  $( [ "$FORCE_REBUILD" = "true" ] && echo "--pull=newer" ) \
  --build-arg BUILD_IMAGE="$FRAPPE_BUILD_REF" \
  --build-arg BASE_IMAGE="$FRAPPE_BASE_REF" \
  --build-arg APP_PINS="$APP_PINS" \
  --secret id=git_token,src="$GIT_TOKEN_SECRET" \
  --build-arg APPS_JSON_BASE64="$BUILD_APPS_JSON" \
  --build-arg PRIVATE_REPOS="$PRIVATE_REPOS" \
  --build-arg FRAPPE_BRANCH="$FRAPPE_BRANCH" \
  -t "$CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG" \
  -f ../actions/configure-module/Dockerfile \
  .

if [ $? -eq 0 ]; then
  print_info "Build completed successfully!"
  print_info "Image tagged as: $CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG"

  # Also tag as latest
  podman tag "$CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG" "$CUSTOM_IMAGE_NAME:latest"

  # Tag with the same name as base image (for drop-in replacement)
  podman tag "$CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG" "$BASE_IMAGE"
  print_info "Also tagged as: $BASE_IMAGE (drop-in replacement)"

  echo ""
  print_info "To push the image to a registry:"
  echo "  podman push $CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG"
  echo "  podman push $CUSTOM_IMAGE_NAME:latest"
  echo "  podman push $BASE_IMAGE"

  echo ""
  print_info "Image size:"
  podman images "$CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG" --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"
  ENV_FILE="environment"

  # Ensure env file exists
  [ -f "$ENV_FILE" ] || {
    print_error "Env file not found"
    exit 1
  }

  CUSTOM_IMAGE_FULL="$CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG"

  # Update or add ERPNEXT_IMAGE
  if grep -q '^ERPNEXT_IMAGE=' "$ENV_FILE"; then
    sed -i "s|^ERPNEXT_IMAGE=.*|ERPNEXT_IMAGE=$CUSTOM_IMAGE_FULL|" "$ENV_FILE"
  else
    echo "ERPNEXT_IMAGE=$CUSTOM_IMAGE_FULL" >>"$ENV_FILE"
  fi

  print_info "Updated ERPNEXT_IMAGE in $ENV_FILE to:"
  print_info "$CUSTOM_IMAGE_FULL"
  print_info "To use this image, it's already tagged as: $BASE_IMAGE"
  print_info "Your existing docker-compose or deployment will automatically use the custom image!"

  # Update the cache with hash, version, image, and timestamp
  CACHE_JSON=$(jq -n \
    --arg hash "$CURRENT_HASH" \
    --arg version "$ERPNEXT_TAG" \
    --arg image "$CUSTOM_IMAGE_NAME:$CUSTOM_IMAGE_TAG" \
    --arg built_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{hash: $hash, version: $version, image: $image, built_at: $built_at}')
  echo "$CACHE_JSON" >"$CACHE_FILE"
  print_info "Cache updated."

  # Record the pins of this build: base image digests, image tag and the
  # commit of every app (written by the Dockerfile into .ns8-pins)
  digest_of() {
    podman image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$1" 2>/dev/null |
      grep -m 1 "^${1%%[:@]*}@sha256:" || echo "$1"
  }
  if commits=$(podman run --rm --entrypoint cat "$CUSTOM_IMAGE_FULL" /home/frappe/frappe-bench/.ns8-pins); then
    echo "$commits" | jq -R -n \
      --arg frappe_branch "$FRAPPE_VERSION" \
      --arg erpnext_tag "$ERPNEXT_TAG" \
      --arg build_image "$(digest_of "$FRAPPE_BUILD_REF")" \
      --arg base_image "$(digest_of "$FRAPPE_BASE_REF")" \
      --arg built_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{frappe_branch: $frappe_branch, erpnext_tag: $erpnext_tag, build_image: $build_image,
        base_image: $base_image, built_at: $built_at,
        apps: ([inputs | select(test("^[a-z][a-z0-9_]* [0-9a-f]{40}$")) | split(" ") | {(.[0]): .[1]}] | add // {})}' \
      >"$PINS_FILE.tmp" && mv "$PINS_FILE.tmp" "$PINS_FILE"
    print_info "Pins recorded in $PINS_FILE"
  else
    print_warning "Cannot read the app commits of the image: pins not recorded"
  fi

  # A new image on an existing install: configure-module dumps every site
  # before the services restart and migrate (75dump_before_migrate)
  if [ -n "$OLD_ERPNEXT_IMAGE" ]; then
    touch .image_changed
  fi

  # Remove old image if it exists and differs from the new one
  if [ -n "$OLD_ERPNEXT_IMAGE" ] && [ "$OLD_ERPNEXT_IMAGE" != "$CUSTOM_IMAGE_FULL" ]; then
    print_info "Removing old image: $OLD_ERPNEXT_IMAGE"
    podman rmi "$OLD_ERPNEXT_IMAGE" 2>/dev/null || print_warning "Could not remove old image (may be in use or already removed)"
  fi

  # Clean up force rebuild flag from env file so subsequent non-force builds work
  if grep -q '^FORCE_REBUILD=' erpnext-modules.env 2>/dev/null; then
    sed -i '/^FORCE_REBUILD=/d' erpnext-modules.env
    print_info "Cleared force rebuild flag."
  fi
else
  print_error "Build failed!"
  exit 1
fi
