#
# Check the app list before anything changes: the format, then for each app
# that its repository answers, that its branch exists, and that it suits
# the Frappe version (version-N branch, frappe range of pyproject.toml).
# bench init would otherwise stop in the middle of the image build. On a
# refusal the running instance and its settings stay as they are.
#

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
from erpnext_apps import AppsError, check_remote, parse  # noqa: E402

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all

data = json.load(sys.stdin)
version = data.get("frappeVersion", "version-15")
token = (data.get("gitToken") or "").strip()
if not token and not data.get("clearGitToken") and os.path.exists("git-token"):
    with open("git-token") as f:
        token = f.read().strip()

try:
    apps, _, _ = parse(data, version)
    check_remote(apps, version, token or None)
except AppsError as ex:
    print(agent.SD_ERR + f"App list refused: {ex.error} {ex.value}", file=sys.stderr)
    agent.set_status("validation-failed")
    json.dump([{"field": ex.field, "parameter": ex.field, "value": ex.value, "error": ex.error}], fp=sys.stdout)
    sys.exit(3)
