{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure erpnext",
    "$id": "http://nethserver.org/json-schema/task/input/erpnext/configure-module",
    "description": "Configure erpnext",
    "examples": [
        {
            "host": "erpnext.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "frappeVersion": "version-15",
            "apps": [
                {
                    "url": "https://github.com/frappe/erpnext",
                    "branch": "version-15"
                },
                {
                    "url": "https://github.com/frappe/hrms",
                    "branch": "version-15"
                }
            ],
            "erpSelectedModules": [
                "erpnext",
                "hrms"
            ]
        },
        {
            "host": "erpnext.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "appJson": "W3sidXJsIjoiaHR0cHM6Ly9naXRodWIuY29tL2ZyYXBwZS9lcnBuZXh0IiwiYnJhbmNoIjoidmVyc2lvbi0xNSIsImFwcF9uYW1lIjoiZXJwbmV4dCJ9XQ=="
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'erpnext.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "appJson": {
            "type": "string",
            "title": "App JSON configuration",
            "description": "The app list encoded in base64, as earlier releases sent it. Use apps instead."
        },
        "frappeVersion": {
            "type": "string",
            "title": "Frappe version",
            "description": "Frappe version branch to use (e.g., version-15 or version-16)",
            "enum": [
                "version-15",
                "version-16"
            ]
        },
        "apps": {
            "type": "array",
            "minItems": 1,
            "title": "Apps of the ERPNext image",
            "description": "Frappe apps built into the image, in the frappe_docker apps.json format. Default: ERPNext of frappeVersion.",
            "items": {
                "type": "object",
                "required": [
                    "url"
                ],
                "properties": {
                    "url": {
                        "type": "string",
                        "pattern": "^https://",
                        "description": "Git repository of the app"
                    },
                    "branch": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Branch or tag; default frappeVersion"
                    },
                    "app_name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "description": "App name; default the repository name"
                    }
                }
            }
        },
        "erpSelectedModules": {
            "type": "array",
            "title": "Apps to install on the site",
            "description": "Names of apps of the list to install on the site. Default: every app of the list.",
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
            }
        },
        "forceRebuild": {
            "type": "boolean",
            "description": "Build the image again even if the app list did not change"
        }
    }
}
