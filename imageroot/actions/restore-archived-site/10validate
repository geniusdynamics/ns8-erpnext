import json
import os
import subprocess
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
import erpnext_sites as es  # noqa: E402


agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all


def fail(error, value):
    agent.set_status("validation-failed")
    json.dump([{"field": "name", "parameter": "name", "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


name = json.load(sys.stdin)["name"]
if not es.is_running("backend"):
    fail("module_not_running", name)
if name not in [r["name"] for r in es.list_archived_sites()]:
    fail("archived_site_not_found", name)
site = es.archived_site_name(name)
if not es.HOST_RE.match(site):
    fail("host_not_valid", name)
if site == os.environ.get("TRAEFIK_HOST") or site in es.load_sites() or site in es.list_sites():
    fail("site_already_exists", name)
if agent.http_route_in_use(domain=site):
    fail("domain_already_used_in_traefik", name)
