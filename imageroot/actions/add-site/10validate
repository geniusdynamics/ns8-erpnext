import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
import erpnext_sites as es  # noqa: E402

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all

request = json.load(sys.stdin)
host = request["host"]


def fail(field, error, value):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


if not es.HOST_RE.match(host):
    fail("host", "host_not_valid", host)
if host == os.environ.get("TRAEFIK_HOST") or host in es.load_sites():
    fail("host", "site_already_exists", host)
if agent.http_route_in_use(domain=host):
    fail("host", "domain_already_used_in_traefik", host)
unknown = [a for a in request.get("apps", []) if a not in es.image_apps()]
if unknown:
    fail("apps", "app_not_in_image", ",".join(unknown))
if not os.environ.get("ERPNEXT_IMAGE") or not es.is_running("backend"):
    fail("host", "module_not_running", host)
