#
# Read configuration
#

import os
import sys
import base64
import binascii
import json
import agent


# Prepare return variable
config = {}

# Read current configuration from the environment file
config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"
config["lets_encrypt"] = os.getenv("TRAEFIK_LETS_ENCRYPT") == "True"
# Load erpnext-modules.env file
if os.path.exists("erpnext-modules.env"):
    data = agent.read_envfile("erpnext-modules.env")
    modules_str = data.get("ERP_NEXT_MODULES", "")
    config["erpSelectedModules"] = modules_str.split(",") if modules_str else []
    config["appJson"] = data.get("APPS_JSON", "")
    try:
        config["apps"] = json.loads(base64.b64decode(config["appJson"])) if config["appJson"] else []
    except (ValueError, binascii.Error):
        config["apps"] = []
    config["frappeVersion"] = data.get("FRAPPE_VERSION", "version-15")
else:
    config["erpSelectedModules"] = []
    config["appJson"] = ""
    config["apps"] = []
    config["frappeVersion"] = "version-15"

cache_file = ".app_json_cache"
if os.path.exists(cache_file):
    try:
        with open(cache_file) as f:
            cache_data = json.load(f)
        config["builtVersion"] = cache_data.get("version", "")
        config["builtImage"] = cache_data.get("image", "")
        config["builtAt"] = cache_data.get("built_at", "")
    except (json.JSONDecodeError, IOError):
        config["builtVersion"] = ""
        config["builtImage"] = ""
        config["builtAt"] = ""
else:
    config["builtVersion"] = ""
    config["builtImage"] = ""
    config["builtAt"] = ""


# Retention of frappe's own backups (set-backup-retention)
def env_int(name, default):
    try:
        return int(os.getenv(name) or default)
    except ValueError:
        return default


config["backupRetention"] = {
    "keep": env_int("FRAPPE_BACKUP_KEEP", 3),
    "max_age_days": env_int("FRAPPE_BACKUP_MAX_AGE_DAYS", 7),
}

# The token itself is a secret: only say whether there is one
config["hasGitToken"] = os.path.exists("git-token")

# Sites and their installed apps (see list-sites). The certificate check
# is left to list-sites: get-configuration must answer fast.
sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
import erpnext_sites  # noqa: E402

try:
    config["sites"] = erpnext_sites.describe_sites()
except erpnext_sites.SiteError as ex:
    print(agent.SD_WARNING + f"cannot list the sites: {ex}", file=sys.stderr)
    config["sites"] = []

# Dump the configuration to stdout
json.dump(config, fp=sys.stdout)
