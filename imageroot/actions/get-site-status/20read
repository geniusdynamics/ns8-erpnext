#
# Reader-safe: background jobs, workers and scheduler of one site.
#
import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))
import erpnext_sites as es  # noqa: E402

name = json.load(sys.stdin)["name"]
if name != es.DEFAULT_SITE and name not in es.load_sites():
    agent.set_status("validation-failed")
    json.dump([{"field": "name", "parameter": "name", "value": name, "error": "site_not_found"}], fp=sys.stdout)
    sys.exit(3)
try:
    json.dump(es.site_status(name), fp=sys.stdout)
except (es.SiteError, ValueError) as ex:
    print(agent.SD_ERR + f"get-site-status {name} failed: {ex}", file=sys.stderr)
    sys.exit(1)
