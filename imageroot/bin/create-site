# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Runs in the create-site container at every start of the module: create
# the default site "frontend" if it is missing, install the selected apps
# that are not installed yet and migrate the site.
#

wait-for-it -t 120 127.0.0.1:6379
wait-for-it -t 120 127.0.0.1:6380
export start=$(date +%s)
until [[ -n $(grep -hs ^ sites/common_site_config.json | jq -r ".db_host // empty") ]] &&
	[[ -n $(grep -hs ^ sites/common_site_config.json | jq -r ".redis_cache // empty") ]] &&
	[[ -n $(grep -hs ^ sites/common_site_config.json | jq -r ".redis_queue // empty") ]]; do
	echo "Waiting for sites/common_site_config.json to be created"
	sleep 5
	if (($(date +%s) - start > 120)); then
		echo "could not find sites/common_site_config.json with required keys"
		exit 1
	fi
done
echo "sites/common_site_config.json found"

# Same runner as FRAPPE_CLI of bin/erpnext_sites.py
export NS8_SECRET_FLAGS
FRAPPE_CLI='
import os, sys
os.chdir("/home/frappe/frappe-bench/sites")
args = sys.argv[1:]
for spec in os.environ.get("NS8_SECRET_FLAGS", "").split():
    flag, var = spec.split("=", 1)
    args.append(flag + "=" + os.environ[var])
sys.argv = ["frappe.utils.bench_helper", "frappe"] + args
from frappe.utils.bench_helper import main
main()
'

# The restore (bin/restore-sites) and the site actions take the same lock:
# never run bench on a site at the same time
if command -v flock >/dev/null 2>&1; then
	exec 9>sites/.ns8-sites.lock
	flock 9
fi

if [[ -f sites/frontend/site_config.json ]]; then
	# During a restore the site files are back before its database: leave
	# the site to bin/restore-sites
	if ! bench --site frontend list-apps >/dev/null 2>&1; then
		echo "Site frontend has no working database yet (restore in progress?): nothing to do"
		exit 0
	fi
else
	# frappe new-site in-process, as bench runs it, with the root password
	# read from the environment: it stays off every command line
	NS8_SECRET_FLAGS="--db-root-password=MARIADB_ROOT_PASSWORD" \
		/home/frappe/frappe-bench/env/bin/python -c "$FRAPPE_CLI" \
		new-site frontend --no-mariadb-socket --admin-password=admin --set-default || exit 1
	NEW_SITE=1
fi

# Convert the comma separated list to a bash array
ERPNEXT_MODULES=$(echo "$ERP_NEXT_MODULES" | tr -d "[]'" | tr -d ' ')
IFS=',' read -r -a ERP_NEXT_MODULES_ARRAY <<<"$ERPNEXT_MODULES"
# An empty list on an existing site means "Frappe only" (set-site-apps)
if [ ${#ERP_NEXT_MODULES_ARRAY[@]} -eq 0 ] && [ -n "$NEW_SITE" ]; then
	echo "No modules specified, installing erpnext by default."
	ERP_NEXT_MODULES_ARRAY=(erpnext)
fi
INSTALLED=$(bench --site frontend list-apps 2>/dev/null)
for module in "${ERP_NEXT_MODULES_ARRAY[@]}"; do
	if grep -qE "^${module}( |$)" <<<"$INSTALLED"; then
		echo "$module is already installed"
		continue
	fi
	echo "Installing $module"
	bench --site frontend install-app "$module"
done
bench --site frontend migrate
bench clear-cache
bench clear-website-cache
