#!/usr/bin/env python3

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Run by the NS8 backup (module-backup) before Restic, in the state/
# directory. Dump the database of every Frappe site into
#
#   state/dumps/<site>/database.sql   consistent dump (--single-transaction)
#   state/dumps/<site>/site.json      apps, scheduler state (no secrets)
#
# The site files (site_config.json, public and private files) are in the
# "sites" volume, which Restic saves as it is. Any failure aborts the backup.
#

import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import agent  # noqa: E402
import erpnext_sites as es  # noqa: E402

DUMPS = "dumps"
# module-backup passes the backup id; dump-before-migrate passes --target
if "--target" in sys.argv[1:-1]:
    DUMPS = sys.argv[sys.argv.index("--target") + 1]
DUMP_FLAGS = [
    "--single-transaction",
    "--quick",
    "--lock-tables=false",
    "--skip-dump-date",
    "--default-character-set=utf8mb4",
]


def dump_database(db_name, path):
    cmd = 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb-dump -uroot "$@"'
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as out:
        proc = subprocess.run(
            ["podman", "exec", "mariadb-app", "sh", "-c", cmd, "sh", *DUMP_FLAGS, db_name],
            stdout=out,
            stderr=subprocess.PIPE,
            text=True,
        )
    if proc.returncode != 0:
        raise es.SiteError(f"mariadb-dump of {db_name} failed: {proc.stderr.strip()}")
    # A complete dump ends with the "Dump completed" comment
    with open(path, "rb") as f:
        f.seek(max(0, os.path.getsize(path) - 256))
        if b"Dump completed" not in f.read():
            raise es.SiteError(f"the dump of {db_name} is incomplete")


def site_metadata(site, db_name):
    meta = {"site": site, "db_name": db_name, "dumped_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    apps = es.mariadb("SELECT app_name, app_version FROM `tabInstalled Application` ORDER BY idx", db_name, check=False)
    if apps is not None:
        meta["apps"] = [dict(zip(("name", "version"), line.split("\t"))) for line in apps.splitlines() if line]
    sched = es.mariadb(
        "SELECT value FROM tabSingles WHERE doctype='System Settings' AND field='enable_scheduler'",
        db_name,
        check=False,
    )
    if sched is not None:
        meta["scheduler_enabled"] = sched.strip() == "1"
    return meta


def prune_frappe_backups():
    """Apply the retention policy to frappe's own backups (every NS8 backup
    runs this). A failure does not fail the backup."""
    proc = subprocess.run(["prune-frappe-backups"], stdout=subprocess.DEVNULL)
    if proc.returncode != 0:
        es.log(agent.SD_WARNING + "prune-frappe-backups failed")


def main():
    env = agent.read_envfile("environment") if os.path.exists("environment") else {}
    if not (os.environ.get("ERPNEXT_IMAGE") or env.get("ERPNEXT_IMAGE")):
        es.log(agent.SD_WARNING + "ERPNext is not configured yet: no site to dump")
        shutil.rmtree(DUMPS, ignore_errors=True)
        os.makedirs(DUMPS, mode=0o700)
        return

    es.require_running("backend", "mariadb-app")
    sites = es.list_sites()
    es.log("Sites to dump:", ", ".join(sites) or "none")

    tmp = DUMPS + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp, mode=0o700)
    for site in sites:
        db_name = es.site_config(site).get("db_name")
        if not db_name:
            raise es.SiteError(f"site {site} has no db_name in site_config.json")
        sdir = os.path.join(tmp, site)
        os.mkdir(sdir, mode=0o700)
        es.log(f"Dumping site {site} (database {db_name})")
        dump_database(db_name, os.path.join(sdir, "database.sql"))
        with open(os.path.join(sdir, "site.json"), "w") as f:
            json.dump(site_metadata(site, db_name), f, indent=1)

    shutil.rmtree(DUMPS, ignore_errors=True)
    os.rename(tmp, DUMPS)
    # Left by earlier releases: the dumps directory replaces it
    if DUMPS == "dumps" and os.path.exists("backup_paths.env"):
        os.remove("backup_paths.env")
    if DUMPS == "dumps":
        prune_frappe_backups()
    es.log(f"Dumped {len(sites)} site(s) into state/{DUMPS}")


if __name__ == "__main__":
    try:
        main()
    except (es.SiteError, OSError, ValueError) as ex:
        print(agent.SD_ERR + f"module-dump-state failed: {ex}", file=sys.stderr)
        sys.exit(1)
